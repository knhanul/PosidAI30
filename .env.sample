# Posid AI담당관3.0 운영 환경 샘플
# 실제 운영 시 이 파일을 .env로 복사한 뒤 CHANGE_ME 값을 변경하세요.
# .env 파일은 Git에 커밋하거나 외부에 공유하지 마세요.

# PostgreSQL: 비밀번호에 특수문자가 있어도 자동으로 URL 인코딩됩니다.
# DATABASE_URL을 비워 두면 아래 POSTGRES_* 값으로부터 자동 생성됩니다.
POSTGRES_USER=posid_ai30
POSTGRES_PASSWORD=CHANGE_TO_A_STRONG_DB_PASSWORD
POSTGRES_DB=posid_ai30
POSTGRES_HOST=db
POSTGRES_PORT=5432
# 필요한 경우에만 직접 지정합니다. 비워 두면 자동 생성됩니다.
DATABASE_URL=

# 최초 1회 관리자 생성. 이미 같은 아이디가 있으면 비밀번호를 덮어쓰지 않습니다.
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=CHANGE_TO_A_STRONG_ADMIN_PASSWORD
INITIAL_ADMIN_DISPLAY_NAME=AI담당관3.0
SESSION_DAYS=7
PERSISTENT_SESSION_DAYS=180
SESSION_REFRESH_THRESHOLD_DAYS=30
SESSION_COOKIE_NAME=posid_ai30_session
COOKIE_SECURE=true
ENVIRONMENT=production
ALLOWED_ORIGINS=

# Kakao OAuth
# 실제 키와 Client Secret은 이 파일이 아니라 운영 서버의 .env에만 입력하세요.
# Client Secret은 Kakao Developer Console에서 시크릿 코드를 활성화한 경우에만 필요합니다.
# 비활성화 상태면 KAKAO_CLIENT_SECRET을 비워 두세요.
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=
# ENVIRONMENT=development이면 개발용, production이면 운영용 URI를 자동 선택합니다.
# KAKAO_REDIRECT_URI는 운영환경에서만 선택적으로 override할 수 있습니다.
KAKAO_REDIRECT_URI=
KAKAO_REDIRECT_URI_DEVELOPMENT=http://127.0.0.1:8091/api/auth/kakao/callback
KAKAO_REDIRECT_URI_PRODUCTION=https://posidai30.nuni.co.kr/api/auth/kakao/callback
KAKAO_LOGIN_ENABLED=false
# state 서명용 시크릿. 비워도 동작하지만 운영 환경에서는 임의의 긴 문자열을 권장합니다.
KAKAO_STATE_SECRET=
# 카카오 로그인 시 이 이메일 목록에 해당하면 관리자 권한을 자동 부여합니다. (쉼표로 구분)
KAKAO_ADMIN_EMAILS=knhanul@naver.com

# WireGuard로 접근 가능한 WebDAV 주소
WEBDAV_URL=http://192.168.0.250/dav/VOL1/Repo
WEBDAV_USERNAME=CHANGE_TO_WEBDAV_USERNAME
WEBDAV_PASSWORD=CHANGE_TO_WEBDAV_PASSWORD
WEBDAV_ROOT=AI담당관3.0
WEBDAV_VERIFY_TLS=true
WEBDAV_TIMEOUT_SECONDS=60

MAX_THUMBNAIL_MB=10
MAX_ATTACHMENT_MB=100
MAX_PROJECT_FILE_MB=2048
